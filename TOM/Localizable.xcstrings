    "Entstanden neben einer Diplomarbeit, gebaut in der Freizeit. Wenn dir TOM Zeit spart, freue ich mich über einen Kaffee." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made alongside a master’s thesis, built in my spare time. If TOM saves you time, I’d be glad about a coffee."
          }
        }
      }
    },
    "erfasst" : {
