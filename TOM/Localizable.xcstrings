    "%lld Einträge gehen dabei verloren. Wenn du die Zeiten behalten willst, archiviere das Projekt stattdessen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld entries will be lost. To keep the times, archive the project instead."
          }
        }
      }
    },
    "%lld Einträge zu %lld Zeilen zusammenführen?": {
      "localizations": {
