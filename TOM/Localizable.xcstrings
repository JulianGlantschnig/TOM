    "Bisher erfasst: %@. Alles ab jetzt geht über die vereinbarte Zeit hinaus." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracked so far: %@. Everything from now on goes beyond the agreed time."
          }
        }
      }
    },
